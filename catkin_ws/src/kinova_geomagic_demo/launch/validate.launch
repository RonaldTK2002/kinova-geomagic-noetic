<launch>
  <!-- 1. Conecta o mundo à base do Kinova Gen3 -->
  <!-- Argumentos: x y z yaw pitch roll frame_pai frame_filho -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_kinova_base" 
        args="0 0 0 0 0 0 world base_link_kinova" />

  <!-- 2. Conecta o mundo à base do Geomagic Touch -->
  <!-- Colocado 0.5 m ao lado no eixo Y para os dois modelos não ficarem colididos no RViz -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_geomagic_base" 
        args="0 0.5 0 0 0 0 world geomagic_base_link" />

  <!-- 3. (Opcional) Executa o seu nó de validação das cinemáticas calculadas -->
  <!-- <node pkg="kinova_geomagic_demo" type="validate_kinematics.py" name="validate_kinematics" output="screen">
    <param name="kinova_base_frame" value="base_link_kinova" />
    <param name="geomagic_base_frame" value="geomagic_base_link" />
    <param name="kinova_calc_frame" value="calculated_kinova_ee" />
    <param name="stylus_calc_frame" value="calculated_stylus_tip" />
  </node> -->
</launch>